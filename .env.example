# ─────────────────────────────────────────────────────────────────
# Lunex Presents — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Django environment: 'development' or 'production'
DJANGO_ENV=development

# Secret key — generate a new one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-in-production

# Comma-separated list of allowed hosts for production
# e.g. ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,yourapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF trusted origins for production (required when behind a proxy/CDN)
# e.g. CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Database URL (leave empty for SQLite in development)
# For production PostgreSQL on Render:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Force HTTPS redirect (set to True in production)
SECURE_SSL_REDIRECT=False
